# MongoDB connection for the standalone FastAPI backend
MONGO_URL=mongodb://localhost:27017
DB_NAME=bdsm_database

# Authentication. Replace with a randomly generated secret (at least 32 bytes).
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Email notifications (server-side only)
EMERGENT_EMAIL_KEY=replace-with-provider-key
EMAIL_FROM_NAME=BDS Marvel
OWNER_EMAIL=admin@example.com
# Optional reply address for notification emails
EMAIL_REPLY_TO=

# Comma-separated frontend origins. Do not use * with credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Optional trusted reverse-proxy CIDRs. Only set to the actual proxy network(s).
# When empty, X-Forwarded-For is ignored and the direct connection IP is used.
TRUSTED_PROXY_CIDRS=

# Optional object storage integration configuration
EMERGENT_LLM_KEY=
INTEGRATION_PROXY_URL=
